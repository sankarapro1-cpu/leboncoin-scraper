# ════════════════════════════════════════════
#  AutoDeal — Configuration
#  Copiez ce fichier en .env et remplissez
# ════════════════════════════════════════════

# ── Application ──────────────────────────────
APP_SECRET_KEY=changez-moi-en-production-mot-de-passe-fort
DEBUG=false

# ── Base de données ──────────────────────────
# SQLite (par défaut, aucune config nécessaire)
DATABASE_URL=sqlite:///./data/leboncoin.db
# PostgreSQL (production recommandée)
# DATABASE_URL=postgresql://user:password@localhost:5432/autodeal

# ── Scraping ─────────────────────────────────
# Intervalle entre chaque cycle (minutes)
SCRAPE_INTERVAL_MINUTES=15

# Délai humain min/max entre requêtes (secondes)
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=6.0

# Nombre max d'annonces collectées par cycle
MAX_LISTINGS_PER_CYCLE=200

# Proxies rotatifs (optionnel, séparés par des virgules)
# Format : http://user:pass@host:port
# PROXY_LIST=http://proxy1:8080,http://proxy2:8080

# ── Alertes Email (Gmail) ─────────────────────
# Activez "Mot de passe d'application" dans votre compte Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application
ALERT_EMAIL_TO=votre-email@gmail.com

# ── Alertes Telegram ──────────────────────────
# 1. Créez un bot via @BotFather sur Telegram
# 2. Récupérez votre Chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFghijklmnopqrstuvwxyz
TELEGRAM_CHAT_ID=987654321

# ── Scoring & Alertes ─────────────────────────
# Score minimum pour déclencher une alerte (0-100)
ALERT_SCORE_THRESHOLD=70

# % sous la moyenne pour qualifier "bonne affaire" (0.85 = 15% moins cher)
GOOD_DEAL_PRICE_THRESHOLD=0.85

# ── Filtres par défaut ────────────────────────
DEFAULT_MAX_PRICE=20000
DEFAULT_MAX_KM=200000
DEFAULT_MIN_YEAR=2010
